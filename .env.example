# Em desenvolvimento, deixe vazio para o proxy do Vite (/api → http://localhost:8080).
# Na Vercel, defina a origem pública da API (sem barra no final), por exemplo:
# https://api.vidaconecta.com.br
VITE_API_URL=

# Domínio do Jitsi Meet (sem protocolo). Local self-hosted (HTTPS): localhost:8443
# A IFrame API do Jitsi monta o embed sempre em https:// — use a porta 8443.
VITE_JITSI_DOMAIN=localhost:8443
VITE_JITSI_PROTOCOL=https
