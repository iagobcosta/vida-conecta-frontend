# Em desenvolvimento, deixe vazio para o proxy do Vite (/api → http://localhost:8080).
# Na Vercel, defina a origem pública da API (sem barra no final), por exemplo:
# https://api.vidaconecta.com.br
VITE_API_URL=

# Domínio do servidor Jitsi Meet (sem protocolo). Padrão: meet.jit.si
# Em homologação/produção self-hosted, use por exemplo: jitsi.seudominio.com
VITE_JITSI_DOMAIN=meet.jit.si
